<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0-M2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.desolatetimelines</groupId>
    <artifactId>acct</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <name>acct</name>
    <description>Account management app</description>

    <packaging>pom</packaging>

    <url/>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>fx89</id>
            <name>Catalin Ioan Georgescu</name>
            <email>catalin.ioan.georgescu@gmail.com</email>
            <url>https://github.com/fx89</url>
            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2024.0.0-M2</spring-cloud.version>
    </properties>

    <modules>
        <!-- The Eureka server -->
        <module>acct-eureka-server</module>

        <!-- The authorization server -->
        <module>acct-authorization-server</module>
        <module>acct-authorization-server-data-spec</module>
        <module>acct-authorization-server-data-rest</module>
        <module>acct-authorization-server-data-mock</module>

        <!-- User management -->
        <module>acct-user-management-ws-spec</module>
        <module>acct-user-management-ws-server</module>
        <module>acct-user-management-ws-client</module>
        <module>acct-user-management-privileges-provider</module>
        <module>acct-user-management-service</module>
        <module>acct-user-management-job</module>
        <module>acct-user-management-data</module>
        <module>acct-user-management-repo-spec</module>
        <module>acct-user-management-repo-springdata</module>
        <module>acct-security-user-management-data</module>
        <module>acct-security-user-management-repo-spec</module>
        <module>acct-security-user-management-repo-rest</module>

        <!-- Security -->
        <module>acct-security-ws-spec</module>
        <module>acct-security-ws-server</module>
        <module>acct-security-ws-client</module>
        <module>acct-security-privileges-provider</module>
        <module>acct-security-service</module>
        <module>acct-security-data-privilegesprovider</module>
        <module>acct-security-data</module>
        <module>acct-security-repo-spec</module>
        <module>acct-security-repo-springdata</module>

        <!-- Usage -->
        <module>acct-usage-ws-spec</module>
        <module>acct-usage-ws-server</module>
        <module>acct-usage-ws-client</module>
        <module>acct-usage-privileges-provider</module>
        <module>acct-usage-service</module>
        <module>acct-usage-data</module>
        <module>acct-usage-repo-spec</module>
        <module>acct-usage-repo-springdata</module>

        <!-- Jobs framework -->
        <module>acct-job-ws-spec</module>
        <module>acct-job-ws-server</module>
        <module>acct-job-ws-client</module>
        <module>acct-job-privileges-provider</module>
        <module>acct-job-service</module>
        <module>acct-job-data</module>
        <module>acct-job-repo-spec</module>
        <module>acct-job-repo-springdata</module>
        <module>acct-job-framework</module>

        <!-- Project-specific reusable dependencies -->
        <module>acct-privileges-provider-spec</module>
        <module>acct-common</module>
        <module>acct-service</module>
        <module>acct-common-rest</module>
        <module>acct-common-ws-spec</module>
        <module>acct-common-ws-server</module>
        <module>acct-common-repo-spec</module>
        <module>acct-usage-ws-redist</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <type>pom</type>
                <version>${spring-cloud.version}</version>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.18.1</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>0.12.6</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
